pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Sourabhf4/todo-app.git'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {

                    def scannerHome = tool 'SonarScanner'

                    sh """
                        ${scannerHome}/bin/sonar-scanner \
                        -Dsonar.projectKey=test \
                        -Dsonar.projectName=test \
                        -Dsonar.sources=. \
                        -Dsonar.host.url=http://34.207.133.163:9000 \
                        -Dsonar.login=squ_aa2618ed4f7bbe800a7be6e889470199146053c1
                    """
                }
            }
        }

        stage('Build Image') {
            steps {
                script {

                    def imageName = "todoapp-image-${BUILD_NUMBER}"

                    sh """
                        docker build -t ${imageName} .
                    """
                }
            }
        }

        stage('Run Container') {
            steps {
                script {

                    def imageName = "todoapp-image-${BUILD_NUMBER}"
                    def containerName = "todoapp-container-${BUILD_NUMBER}"

                    sh """
                        docker run -d \
                        --name ${containerName} \
                        -P \
                        ${imageName}
                    """
                }
            }
        }
    }
}
